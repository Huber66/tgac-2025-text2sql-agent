# Optional: cached demo works without a model API key.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# demo: bundled synthetic data; competition: locally supplied competition data.
TGAC_PROFILE=demo
DB_HOST=127.0.0.1
DB_PORT=19030
DB_USER=root
DB_PASSWORD=
# Leave DB_NAME unset to use tgac_demo or tgac_contest for the selected profile.
# DB_NAME=tgac_demo
# TGAC_DATA_DIR=data/competition
