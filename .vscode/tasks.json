{
  "version": "2.0.0",
  "tasks": [
    {"label": "TGAC: start StarRocks", "type": "process", "command": "docker", "args": ["compose", "up", "-d", "--wait", "--wait-timeout", "240"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "TGAC: initialize empty database", "type": "process", "command": "${command:python.interpreterPath}", "args": ["reset_and_init_db.py", "--mode", "init"], "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONUTF8": "1"}}, "problemMatcher": []},
    {"label": "TGAC: check environment", "type": "process", "command": "${command:python.interpreterPath}", "args": ["check_environment.py"], "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONUTF8": "1"}}, "problemMatcher": []},
    {"label": "TGAC: stop StarRocks", "type": "process", "command": "docker", "args": ["compose", "stop"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []}
  ]
}
